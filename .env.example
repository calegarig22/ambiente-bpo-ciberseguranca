# Copie este arquivo para .env.local e preencha. Nunca commite o arquivo real.
# As variáveis são lidas só pelo servidor (api/), nunca vão para o navegador.

# Neon: Dashboard > seu projeto > Connect > copie a "connection string"
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo que assina o cookie de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=

# Leitura automática de arquivos com IA (Google Gemini, plano gratuito).
# Crie a chave em https://aistudio.google.com/apikey (conta Google, sem cartão).
# Sem ela, a aplicação funciona normalmente, mas o preenchimento é manual.
GEMINI_API_KEY=
# Opcional: outro modelo do Gemini (padrão: gemini-3.8-flash)
GEMINI_MODELO=
